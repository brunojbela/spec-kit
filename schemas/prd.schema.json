{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit.dev/schemas/prd.schema.json",
  "title": "PRD",
  "type": "object",
  "required": ["metadata", "sharedContext", "features", "tasks"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["project", "version", "owner", "createdAt", "status"],
      "properties": {
        "project": { "type": "string" },
        "displayName": { "type": "string" },
        "version": { "type": "string" },
        "owner": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string" },
        "harness": { "type": "string" },
        "status": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "sharedContext": {
      "type": "object",
      "required": ["objetivo", "principios"],
      "properties": {
        "objetivo": { "type": "string" },
        "principios": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "harnesses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "goal"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2,}$" },
          "name": { "type": "string" },
          "goal": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "feature", "what", "why", "acceptanceCriteria", "difficulty", "model", "dependsOn", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{2,}$" },
          "feature": { "type": "string", "pattern": "^F[0-9]{2,}$" },
          "what": { "type": "string", "minLength": 10 },
          "why": { "type": "string", "minLength": 3 },
          "acceptanceCriteria": { "type": "string", "minLength": 10 },
          "difficulty": { "enum": ["trivial", "fácil", "médio", "difícil", "extremamente difícil"] },
          "model": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2,}$" } },
          "status": { "enum": ["pendente", "em-progresso", "concluída", "bloqueada"] },
          "assignee": { "type": "string" },
          "tokens": { "type": "number" },
          "prompts": { "type": "number" }
        }
      }
    },
    "nonFunctionalRequirements": { "type": "array" }
  }
}
